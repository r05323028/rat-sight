{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-ratsight-geospatial-smoke/types/**/*.ts",
    ".next-ratsight-geospatial-smoke/dev/types/**/*.ts",
    ".next-ratsight-rodent-report-smoke/types/**/*.ts",
    ".next-ratsight-rodent-report-smoke/dev/types/**/*.ts",
    ".next-ratsight-qa-analyst/types/**/*.ts",
    ".next-ratsight-qa-analyst/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
